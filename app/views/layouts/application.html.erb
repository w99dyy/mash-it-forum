<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Mash It Forum" %></title>
    <%= render 'application/favicon' %>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Mash-it Artists Forum">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <div data-controller="sidebar">

    <header class="bg-[#161616] ring shadow-lg h-17 ring-gray-900/5 border-b border-[#2a2a2a] flex items-center sticky top-0 z-30">

      <svg data-sidebar-target="hideSideBar" data-action="click->sidebar#toggle" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
      class="icon icon-tabler icons-tabler-outline icon-tabler-menu-2 ml-3 cursor-pointer">
        <path stroke="none" d="M0 0h24v24H0z" fill="none" />
        <path d="M4 6l16 0" />
        <path d="M4 12l16 0" />
        <path d="M4 18l16 0" />
      </svg>

      <%= link_to image_tag("logo.png"), root_path, class: "inline-block ml-2 w-50 md:w-auto pb-2" %>
      <%= link_to "Mash-it.io", "https://mash-it.io/mashers", class: "hidden sm:block" %>
      <%= link_to "About", about_path, class: "hidden sm:block pl-4" %>

      <% if user_signed_in? %>
        <div class="flex items-center ml-auto mr-5">
          <div class="relative inline-block">
            <%= link_to notifications_path do %>
              <span class="absolute -top-3 -right-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-bell text-gray-400 hover:text-gray-300 transition">
                  <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                  <path d="M10 5a2 2 0 1 1 4 0a7 7 0 0 1 4 6v3a4 4 0 0 0 2 3h-16a4 4 0 0 0 2 -3v-3a7 7 0 0 1 4 -6" />
                  <path d="M9 17v1a3 3 0 0 0 6 0v-1" />
                </svg>
              </span>
            <% end %>

            <% if current_user.notifications.unread.any? %>
              <%= link_to notifications_path do %>
                <span class="absolute -top-4 -right-3 flex items-center justify-center w-4 h-4 text-xs bg-[#ed5024] text-white rounded-full">
                  <%= current_user.notifications.unread.count %>
                </span>
              <% end %>
            <% end %>
          </div>
        </div>

        <div data-controller="avatar-menu" class="dropdown relative">
          <button data-action="click->avatar-menu#toggle"
                  class="focus:outline-none flex items-center cursor-pointer">
            <%= render 'avatar_pfp/mashit_avatar_sm', user: current_user %>
          </button>

          <div data-avatar-menu-target="menu" class="dropdown-menu hidden absolute right-2 mt-2 w-48 bg-[#1f1f1f] rounded-lg shadow-lg">
            <div class="p-4 flex flex-wrap items-center gap-2">
              <%= render 'avatar_pfp/mashit_avatar_comments', user: current_user %>
              <p class="font-semibold text-sm text-white"><%= current_user.username %></p>
            </div>
            <ul>
              <li>
                <%= link_to profile_path(current_user), class: "block px-4 py-3 text-sm hover:text-[#ababab] flex flex-wrap items-center gap-2" do %>
                  <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-user"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M8 7a4 4 0 1 0 8 0a4 4 0 0 0 -8 0" /><path d="M6 21v-2a4 4 0 0 1 4 -4h4a4 4 0 0 1 4 4v2" /></svg>
                  <span>View Profile</span>
                <% end %>
              </li>
              <% if current_user&.admin? %>
                <li class="block sm:hidden">
                  <%= link_to new_topic_path, class: "block px-4 py-3 text-sm hover:text-[#ababab] flex flex-wrap items-center gap-2" do %>
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-ballpen"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M14 6l7 7l-4 4" /><path d="M5.828 18.172a2.828 2.828 0 0 0 4 0l10.586 -10.586a2 2 0 0 0 0 -2.829l-1.171 -1.171a2 2 0 0 0 -2.829 0l-10.586 10.586a2.828 2.828 0 0 0 0 4" /><path d="M4 20l1.768 -1.768" /></svg>
                    <span>New topic</span>
                  <% end %>
                </li>

                <li>
                  <%= link_to avo_path, class: "block px-4 py-3 text-sm text-red-500 flex flex-wrap items-center gap-2" do %>
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="currentColor" class="icon icon-tabler icons-tabler-filled icon-tabler-shield-half"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M11.998 2l.032 .002l.086 .005a1 1 0 0 1 .342 .104l.105 .062l.097 .076l.016 .015l.247 .21a11 11 0 0 0 7.189 2.537l.342 -.01a1 1 0 0 1 1.005 .717a13 13 0 0 1 -9.208 16.25a1 1 0 0 1 -.502 0a13 13 0 0 1 -9.209 -16.25a1 1 0 0 1 1.005 -.717a11 11 0 0 0 7.791 -2.75l.046 -.036l.053 -.041a1 1 0 0 1 .217 -.112l.075 -.023l.036 -.01a1 1 0 0 1 .12 -.022l.086 -.005zm.002 2.296l-.176 .135a13 13 0 0 1 -7.288 2.572l-.264 .006l-.064 .31a11 11 0 0 0 1.064 7.175l.17 .314a11 11 0 0 0 6.49 5.136l.068 .019z" /></svg>
                    <span>Admin Panel</span>
                  <% end %>
                </li>
              <% end %>
              <li>
                <%= button_to destroy_user_session_path, method: :delete, class: "w-full text-left px-4 py-2 text-sm text-red-500 hover:text-red-600 mb-2 flex flex-wrap items-center gap-2" do %>
                  <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-logout-2"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M10 8v-2a2 2 0 0 1 2 -2h7a2 2 0 0 1 2 2v12a2 2 0 0 1 -2 2h-7a2 2 0 0 1 -2 -2v-2" /><path d="M15 12h-12l3 -3" /><path d="M6 15l-3 -3" /></svg>
                  <span>Sign out</span>
                <% end %>
              </li>
            </ul>
          </div>
        </div>
      <% else %>
        <%= link_to "Sign in", sign_in_path, class: "bg-[#ed5024] hover:bg-[#e0603c] inline-block text-white font-medium mr-2 py-1 px-3 rounded-full shadow transition duration-200 ml-auto" %>
      <% end %>
    </header>

    <%# pinned nav bar %>
    <div class="flex flex-grow min-h-screen">

      <div data-sidebar-target="backdrop"
         data-action="click->sidebar#toggle"
         class="hidden fixed inset-0 bg-black/20 z-10 md:hidden">
      </div>

      <nav data-sidebar-target="sidebar" class="fixed top-17 left-0 w-64 h-screen -translate-x-full
            md:sticky md:h-[calc(100vh-4.25rem)] overflow-y-auto
             z-20 bg-[#161616] border-r border-[#2a2a2a] shadow-lg transition-transform duration-300 transform">
        <ul class="space-y-1 p-3 mt-2">
          <%# New topic %>
          <% if current_user&.admin? %>
            <li>
              <%= link_to new_topic_path, class: "flex items-center gap-3 pl-2 px-3 py-2.5 rounded-lg transition-all duration-200 group text-gray-400 hover:text-white hover:bg-[#2a2a2a]" do %>
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-ballpen">
                  <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                  <path d="M14 6l7 7l-4 4" />
                  <path d="M5.228 18.172a2.828 2.828 0 0 0 4 0l10.586 -10.586a2 2 0 0 0 0 -2.829l-1.171 -1.171a2 2 0 0 0 -2.829 0l-10.586 10.586a2.828 2.828 0 0 0 0 4" />
                  <path d="M4 20l1.768 -1.768" />
                </svg>
                <span class="text-gray-300 group-hover:text-white text-sm">New topic</span>
                <span class="admin-badge ml-auto text-xs bg-[#ed5024]/20 text-[#ed5024] px-2 py-0.5 rounded-full opacity-0 group-hover:opacity-100 transition-opacity duration-200">Admin</span>
              <% end %>
            </li>
          <% end %>

          <%# topics page %>
          <li data-controller="disclosure">
            <button
              data-action="click->disclosure#toggle"
              class="w-full flex items-center gap-3 pl-2 px-3 py-2.5 rounded-lg transition-all duration-200 group text-gray-400 hover:text-white hover:bg-[#2a2a2a]">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                <path d="M21 14l-3 -3h-7a1 1 0 0 1 -1 -1v-6a1 1 0 0 1 1 -1h9a1 1 0 0 1 1 1v10" />
                <path d="M14 15v2a1 1 0 0 1 -1 1h-7l-3 3v-10a1 1 0 0 1 1 -1h2" />
              </svg>
              <span class="text-gray-300 group-hover:text-white text-sm flex-1 text-left">Topics</span>
              <svg data-disclosure-target="chevron" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-200 mr-1">
                <path d="M6 9l6 6 6-6" />
              </svg>
            </button>

            <ul data-disclosure-target="menu" class="hidden mt-1 ml-7 space-y-0.5 transition-all duration-200 ease-out transform">
              <% pinned_topics.each do |topic| %>
                <li>
                  <%= link_to topic_path(topic), class: "flex items-center gap-2 px-3 py-2 rounded-lg text-sm text-gray-400 hover:text-white hover:bg-[#2a2a2a] transition-all duration-200" do %>
                    <span class="truncate"><%= topic.title %></span>
                  <% end %>
                </li>
              <% end %>
            </ul>
          </li>

          <li>
            <% if user_signed_in? %>
              <%= link_to profile_path(current_user), class: "flex items-center gap-3 px-3 pl-2 py-2.5 rounded-lg transition-all duration-200 group text-gray-400 hover:text-white hover:bg-[#2a2a2a]" do %>
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-user">
                  <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                  <path d="M8 7a4 4 0 1 0 8 0a4 4 0 0 0 -8 0" />
                  <path d="M6 21v-2a4 4 0 0 1 4 -4h4a4 4 0 0 1 4 4v2" />
                </svg>
                <span class="text-gray-300 group-hover:text-white text-sm">Profile</span>
              <% end %>
            <% end %>
          </li>
        </ul>
      </nav>

      <body class="bg-[#161616] min-h-screen text-white">
        <main class="flex-1 min-w-0">
          <div class="container mx-auto mt-5 mb-5">
            <%= yield %>
          </div>
        </main>
      </body>
    </div>
    <%= render "application/footer" %>
  </div>
</html>
