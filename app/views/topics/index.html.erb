<% content_for :title, "All Topics" %>

<div class="posts-page min-h-screen mx-auto px-2 md:px-0 md:w-5/6 mb-17 md:mb-0">
  <%# Page Header %>
  <div class="mb-2 border-b border-[#2a2a2a]">
    <div class="flex items-end justify-between text-gray-400 gap-4 mb-2">
      <h1 class="text-2xl font-bold text-white break-words">Topics</h1>
      <div class="hidden sm:flex gap-4">
        <p>Posts</p>
        <p>Comments</p>
      </div>
    </div>
  </div>

  <%# Topics List %>
  <div class="topics-container overflow-visible">
    <% if @topics.any? %>
      <% @topics.each do |topic| %>
        <div class="topic mt-3 pb-4 bg-[#1a1a1a] rounded-md p-2 <%= 'bg-orange-500/10' if topic.pinned? %>">
          <%# Stats Column (Right side) %>
          <div class="float-right text-gray-400 hidden sm:block">
            <div class="flex items-center">
              <div class="min-w-[2.5rem] text-center tabular-nums">
                <span class="block"><%= topic.posts_count.to_i %></span>
              </div>
              <div class="min-w-[5.5rem] text-right tabular-nums">
                <span class="block"><%= topic.posts.sum { |p| p.comments_count.to_i } %></span>
              </div>
            </div>
          </div>

          <%# Topic Title %>
          <div class="flex items-center flex-wrap">
            <h2>
              <%= link_to topic.title, topic_posts_path(topic), class: "hover:text-[#ababab] transition font-bold" %>
              <span>
                <% if topic.pinned? %>
                  <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="currentColor" class="icon icon-tabler icons-tabler-filled icon-tabler-pinned inline-block align-middle" style="color: green">
                    <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                    <path d="M16 3a1 1 0 0 1 .117 1.993l-.117 .007v4.764l1.894 3.789a1 1 0 0 1 .1 .331l.006 .116v2a1 1 0 0 1 -.883 .993l-.117 .007h-4v4a1 1 0 0 1 -1.993 .117l-.007 -.117v-4h-4a1 1 0 0 1 -.993 -.883l-.007 -.117v-2a1 1 0 0 1 .06 -.34l.046 -.107l1.894 -3.791v-4.762a1 1 0 0 1 -.117 -1.993l.117 -.007h8z" />
                  </svg>
                <% end %>
                <% if topic.locked? %>
                  <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="currentColor" class="icon icon-tabler icons-tabler-filled icon-tabler-lock inline-block align-middle" style="color: gray">
                    <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                    <path d="M12 2a5 5 0 0 1 5 5v3a3 3 0 0 1 3 3v6a3 3 0 0 1 -3 3h-10a3 3 0 0 1 -3 -3v-6a3 3 0 0 1 3 -3v-3a5 5 0 0 1 5 -5m0 12a2 2 0 0 0 -1.995 1.85l-.005 .15a2 2 0 1 0 2 -2m0 -10a3 3 0 0 0 -3 3v3h6v-3a3 3 0 0 0 -3 -3" />
                  </svg>
                <% end %>
              </span>
            </h2>
          </div>

          <%# Tags %>
          <% if topic.tags.any? %>
            <div class="tags mt-2">
              <div class="flex flex-wrap gap-2">
                <% topic.tags.each do |tag| %>
                  <%= link_to tag.name, topics_path(tag: tag.name), class: "bg-[#de7200] px-4 py-0.5 rounded-full text-sm hover:bg-[#df8322]" %>
                <% end %>
              </div>
            </div>
          <% end %>
          <div class="text-gray-400 flex md:hidden justify-end gap-4">
          <div class="min-w-[2.5rem] text-center tabular-nums">
            <span class="flex items-center"><%= topic.posts_count.to_i %>
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-ballpen ml-1"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M14 6l7 7l-4 4" /><path d="M5.828 18.172a2.828 2.828 0 0 0 4 0l10.586 -10.586a2 2 0 0 0 0 -2.829l-1.171 -1.171a2 2 0 0 0 -2.829 0l-10.586 10.586a2.828 2.828 0 0 0 0 4" /><path d="M4 20l1.768 -1.768" /></svg>
            </span>
            </div>
            <div class="min-w-[2.5rem] text-center tabular-nums">
            <span class="flex items-center"><%= topic.posts.sum { |p| p.comments_count.to_i } %>
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-bubble-text ml-1"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M7 10h10" /><path d="M9 14h5" /><path d="M12.4 3a5.34 5.34 0 0 1 4.906 3.239a5.333 5.333 0 0 1 -1.195 10.6a4.26 4.26 0 0 1 -5.28 1.863l-3.831 2.298v-3.134a2.668 2.668 0 0 1 -1.795 -3.773a4.8 4.8 0 0 1 2.908 -8.933a5.33 5.33 0 0 1 4.287 -2.16" /></svg>
            </span>
            </div>
          </div>
        </div>
      <% end %>
    <% else %>
      <div class="empty-state text-center py-16 rounded-lg">
        <h3 class="text-2xl font-bold text-white mb-2">No topics yet</h3>
        <p class="text-gray-400 mb-6">Wait for an Admin to create one.</p>
      </div>
    <% end %>
  </div>
</div>